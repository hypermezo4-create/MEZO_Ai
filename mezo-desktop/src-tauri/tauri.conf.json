{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEZO AI",
  "version": "1.0.0",
  "identifier": "com.mezo.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../mezo-frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../mezo-frontend run build",
    "frontendDist": "../../mezo-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MEZO AI",
        "url": "http://127.0.0.1:8787",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8787; style-src 'self' 'unsafe-inline' http://127.0.0.1:8787; img-src 'self' data: http://127.0.0.1:8787; connect-src 'self' ipc: http://127.0.0.1:8787"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "MEZO AI Desktop Interface",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
