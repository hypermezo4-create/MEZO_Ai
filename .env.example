# API (all secrets must be replaced before production)
MEZO_ENV=development
DATABASE_URL=postgresql+psycopg://mezo:replace-me@localhost:5432/mezo
JWT_SECRET=replace-with-at-least-32-random-characters
AUDIT_HMAC_KEY=replace-with-an-independent-32-character-key
MEZO_BOOTSTRAP_TOKEN=replace-with-one-time-bootstrap-token
CORS_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost
ACCESS_TOKEN_MINUTES=30
TASK_LEASE_SECONDS=120
RUNNER_OFFLINE_SECONDS=45
APPROVAL_EXPIRATION_MINUTES=30
LOG_LEVEL=INFO

# Runner registration and private API URL
RUNNER_REGISTRATION_TOKEN=replace-with-runner-registration-token
MEZO_API_URL=http://localhost:8080
RUNNER_NAME=mezo-runner-local
MEZO_RUNNER_VERSION=1.0.0
MEZO_RUNNER_TOKEN=
RUNNER_HEARTBEAT_SECONDS=10
RUNNER_POLL_SECONDS=2
WORKSPACE_ROOT=/workspaces
RUNNER_DATA_ROOT=/data
FAILED_WORKSPACE_RETENTION=delete
KILO_TASK_TIMEOUT_SECONDS=3600

# GitHub App. Store the private key with Fly secrets in production.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_URL=https://api.github.com

# Kilo/model authentication (configure one supported provider)
KILOCODE_API_KEY=
KILO_API_KEY=
KILO_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
LOCAL_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_OPENAI_MODEL=
LOCAL_OPENAI_API_KEY=

# Frontend build-time URL; leave blank when reverse-proxied on the same origin.
VITE_MEZO_API_URL=http://localhost:8080
MEZO_FRONTEND_DIST=/app/frontend
